GEMINI_API_KEY=
# Free-tier model used by Bitewise. Keep this on gemini-3.1-flash-lite for zero-cost API use.
GEMINI_MODEL=gemini-3.1-flash-lite
# Attach to the existing Chrome for Testing instance used by your local automation apps.
BITEWISE_CHROME_CDP_URL=http://127.0.0.1:9222
REWE_LIVE_ENABLED=false
REWE_BROWSER_ENABLED=true
REWE_BROWSER_HEADLESS=true
REWE_BROWSER_CHANNEL=
REWE_REFRESH_INTERVAL_DAYS=90
BITEWISE_LOCAL_DB_PATH=
AUTO_RESTORE_LOCAL_REWE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloud sync / auth
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional but recommended for a private one-person app:
ALLOWED_USER_EMAIL=
