GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
GEMINI_RETRIES_PER_MODEL=2
REWE_LIVE_ENABLED=false
REWE_BROWSER_ENABLED=true
REWE_BROWSER_HEADLESS=true
REWE_BROWSER_CHANNEL=
REWE_REFRESH_INTERVAL_DAYS=90
BITEWISE_LOCAL_DB_PATH=
AUTO_RESTORE_LOCAL_REWE=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Cloud sync / auth
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional but recommended for a private one-person app:
ALLOWED_USER_EMAIL=
